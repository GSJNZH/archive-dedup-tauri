{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchiveDedup",
  "version": "1.3.0",
  "identifier": "com.gsjhzh.archivededup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "素材归档去重工具",
        "width": 1180,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
